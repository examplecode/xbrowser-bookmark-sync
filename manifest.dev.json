{
  "manifest_version": 3,
  "name": "__MSG_extName__ (开发版)",
  "version": "1.0.10-dev",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "host_permissions": [
    "https://www.xbext.com/*",
    "https://en.xbext.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
